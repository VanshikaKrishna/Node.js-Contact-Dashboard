<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Contact App</title>
  <style>
    /* Global Reset & Body Styles */
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    }

    body {
      background-color: #f9fafb;
      display: flex;
      flex-direction: column;
      align-items: center;
      padding-top: 2rem;
      min-height: 100vh;
    }

    /* Top Red Header */
    .app-title {
      color: #ea580c;
      font-size: 1.25rem;
      font-weight: 700;
      letter-spacing: 0.05em;
      text-transform: uppercase;
      margin-bottom: 2.5rem;
    }

    /* Table Container Card */
    .card {
      width: 100%;
      max-width: 1024px;
      background-color: #ffffff;
      border: 1px solid #e5e7eb;
      border-radius: 0.25rem;
      box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
      overflow: hidden;
    }

    /* Blue Banner Header */
    .card-header {
      background-color: #1e3a8a;
      padding: 1rem 1.5rem;
      display: flex;
      justify-content: space-between;
      align-items: center;
      color: #ffffff;
    }

    .card-header h2 {
      font-size: 1.5rem;
      font-weight: 400;
    }

    /* Green Add Button */
    .btn-add {
      background-color: #22c55e;
      color: white;
      border: none;
      padding: 0.5rem 1rem;
      border-radius: 0.25rem;
      font-size: 0.875rem;
      font-weight: 600;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
    }

    .btn-add::before {
      content: "";
      display: inline-block;
      width: 8px;
      height: 8px;
      background-color: white;
      border-radius: 50%;
    }

    .btn-add:hover {
      background-color: #16a34a;
    }

    /* Table Formatting */
    .table-responsive {
      overflow-x: auto;
    }

    table {
      width: 100%;
      border-collapse: collapse;
      text-align: left;
      font-size: 0.875rem;
      color: #374151;
    }

    th {
      background-color: #ffffff;
      color: #111827;
      font-weight: 700;
      padding: 1rem;
      border-bottom: 2px solid #e5e7eb;
    }

    td {
      padding: 1rem;
      border-bottom: 1px solid #f3f4f6;
    }

    tr:nth-child(even) {
      background-color: #f9fafb;
    }

    tr:hover {
      background-color: #f3f4f6;
    }

    /* Alignment Widths */
    .col-num {
      width: 50px;
      text-align: center;
    }

    .col-actions {
      width: 150px;
      text-align: center;
    }

    /* Action Circle Buttons */
    .actions-flex {
      display: flex;
      justify-content: center;
      align-items: center;
      gap: 0.5rem;
    }

    .action-btn {
      width: 28px;
      height: 28px;
      border-radius: 50%;
      background: white;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      font-size: 0.75rem;
      font-weight: bold;
      cursor: pointer;
      transition: background-color 0.2s;
      text-decoration: none;
      /* Prevents underlines on links */
    }


    /* Action Variant Colors */
    .btn-view {
      border: 1px solid #38bdf8;
      color: #0284c7;
    }

    .btn-view:hover {
      background-color: #f0f9ff;
    }

    .btn-edit {
      border: 1px solid #d1d5db;
      color: #4b5563;
    }

    .btn-edit:hover {
      background-color: #f9fafb;
    }

    .btn-delete {
      border: 1px solid #f87171;
      color: #dc2626;
    }

    .btn-delete:hover {
      background-color: #fef2f2;
    }



    /* App Container Sizing Overrides */
    .form-card {
      max-width: 600px;
      /* Thinner layout card to match image proportions */
      margin: 0 auto;
    }

    /* Form Grid Layout styles */
    .form-body {
      padding: 2rem 2.5rem;
    }

    .form-group {
      display: flex;
      align-items: center;
      margin-bottom: 1.25rem;
    }

    .form-group.align-top {
      align-items: flex-start;
    }

    .form-group label {
      width: 140px;
      /* Perfect left-side alignment offset */
      font-size: 0.9rem;
      color: #374151;
      font-weight: 500;
    }

    /* Inputs & Textareas */
    .form-group input,
    .form-group textarea {
      flex: 1;
      padding: 0.5rem;
      border: 1px solid #d1d5db;
      border-radius: 0.25rem;
      font-size: 0.95rem;
      outline: none;
      background-color: #ffffff;
    }

    .form-group input:focus,
    .form-group textarea:focus {
      border-color: #2563eb;
    }

    .form-group textarea {
      resize: vertical;
    }

    /* Action Buttons Alignment */
    .form-actions {
      display: flex;
      justify-content: flex-start;
      gap: 0.75rem;
      padding-left: 140px;
      /* Offsets buttons directly below inputs */
      margin-top: 1.5rem;
    }

    /* Save Button */
    .btn-save {
      background-color: #2563eb;
      color: #ffffff;
      border: none;
      padding: 0.5rem 1rem;
      font-size: 0.875rem;
      font-weight: 500;
      border-radius: 0.25rem;
      cursor: pointer;
    }

    .btn-save:hover {
      background-color: #1d4ed8;
    }

    /* Cancel Button */
    .btn-cancel {
      background-color: #ffffff;
      color: #4b5563;
      border: 1px solid #d1d5db;
      padding: 0.5rem 1rem;
      font-size: 0.875rem;
      font-weight: 500;
      border-radius: 0.25rem;
      text-decoration: none;
      display: inline-block;
      cursor: pointer;
    }

    .btn-cancel:hover {
      background-color: #f9fafb;
    }

    /* Details Card Specific Container */
    .details-card {
      max-width: 600px;
      margin: 0 auto;
    }

    .details-body {
      padding: 2rem 2.5rem 1.5rem 2.5rem;
    }

    /* Row Alignments */
    .details-group {
      display: flex;
      margin-bottom: 1.25rem;
      font-size: 0.95rem;
    }

    .details-group.align-top {
      align-items: flex-start;
    }

    /* Left-Side Bold Labels */
    .details-label {
      width: 140px;
      font-weight: 500;
      color: #374151;
    }

    /* Right-Side Pure Text Fields */
    .details-value {
      flex: 1;
      color: #111827;
    }

    .details-value.text-muted {
      color: #6b7280;
    }

    /* Subtle separator rule above buttons */
    .details-divider {
      border: 0;
      border-top: 1px solid #f3f4f6;
      margin-top: 2rem;
      margin-bottom: 1rem;
    }

    /* Action Link Buttons Container */
    .details-actions {
      display: flex;
      justify-content: center;
      gap: 0.5rem;
      width: 100%;
    }

    .btn-action {
      padding: 0.4rem 1.2rem;
      font-size: 0.875rem;
      font-weight: 500;
      border-radius: 0.25rem;
      text-decoration: none;
      display: inline-block;
      text-align: center;
      cursor: pointer;
      transition: all 0.2s;
    }

    /* Solid Teal Edit Button */
    .btn-teal {
      background-color: #0d9488;
      color: #ffffff;
      border: 1px solid #0d9488;
    }

    .btn-teal:hover {
      background-color: #0f766e;
    }

    /* Red Outline Delete Button */
    .btn-danger-outline {
      background-color: #ffffff;
      color: #ef4444;
      border: 1px solid #fca5a5;
    }

    .btn-danger-outline:hover {
      background-color: #fef2f2;
    }

    /* Cancel Button stays matching former styles */
    .btn-cancel {
      background-color: #ffffff;
      color: #4b5563;
      border: 1px solid #d1d5db;
    }

    .btn-cancel:hover {
      background-color: #f9fafb;
    }


    /* Container Banner (For reference context) */
    .card-header {
      background-color: #2b4560;
      /* Dark blue slate color from the image */
      padding: 0.75rem 1.25rem;
      display: flex;
      justify-content: space-between;
      align-items: center;
      color: #ffffff;
    }

    /* Redesigned Add New Link Button */
    .btn-add-new {
      background-color: #15803d;
      /* Darker vibrant green matching the image */
      color: #ffffff;
      text-decoration: none;
      font-size: 0.75rem;
      /* Small font size scaling */
      font-weight: 500;
      padding: 0.4rem 0.75rem;
      border-radius: 0.2rem;
      display: inline-flex;
      align-items: center;
      gap: 0.4rem;
      transition: background-color 0.2s ease;
    }

    .btn-add-new:hover {
      background-color: #166534;
    }

    /* White Circle Plus Icon */
    .plus-icon {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 12px;
      height: 12px;
      background-color: #ffffff;
      color: #15803d;
      /* Text matches parent container green */
      border-radius: 50%;
      font-size: 0.7rem;
      font-weight: 800;
      line-height: 1;
    }

    /* Pagination Wrapper Styling */
.pagination {
  display: flex;
  padding-left: 0;
  list-style: none;
  margin: 20px 0;
  gap: 5px; /* Spaces out your page numbers nicely */
}

/* Individual Item Link Styling */
.pagination .page-item .page-link {
  position: relative;
  display: block;
  padding: 8px 16px;
  color: #007bff;
  text-decoration: none;
  background-color: #fff;
  border: 1px solid #dee2e6;
  border-radius: 4px;
  transition: all 0.2s ease-in-out;
}

/* Hover effects */
.pagination .page-item :hover {
  background-color: #e9ecef;
  border-color: #dee2e6;
}

/* Active Page State */
.pagination .page-item.active .page-link {
  z-index: 3;
  color: #fff;
  background-color: #007bff;
  border-color: #007bff;
}

/* Disabled State for Previous/Next */
.pagination .page-item.disabled .page-link {
  color: #6c757d;
  pointer-events: none;
  cursor: auto;
  background-color: #fff;
  border-color: #dee2e6;
}

  </style>
</head>

<body>
  <!-- Top Header Title -->
  <a href="/" style="text-decoration: none;">
    <h1 class="app-title">CONTACT APP</h1>
  </a>


  <!-- Main Card Container -->
  <div class="card">

    <!-- Card Header Banner -->
    <div class="card-header">
      <h2>All Contacts</h2>
      <!-- <button class="btn-add">Add New</button> -->
      <a href="/add-contact" class="btn-add-new" title="Add New Contact">
        <span class="plus-icon">+</span> Add New
      </a>

    </div>